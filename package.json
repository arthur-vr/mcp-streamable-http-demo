{
  "name": "mcp-streamablehttp-demo",
  "version": "1.0.0",
  "description": "Demo of MCP Streamable HTTP protocol",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "tsx watch src/client.ts",
    "build": "tsc",
    "start:server": "tsx dist/server.js",
    "start:client": "tsx dist/client.js",
    "postinstall": "tsx bin/fix-package-error.ts",
    "cleanup": "rimraf node_modules dist package-lock.json"
  },
  "keywords": [
    "mcp",
    "streamable-http",
    "typescript"
  ],
  "author": "SmileyCat",
  "dependencies": {
    "@mastra/core": "^0.8.2",
    "@modelcontextprotocol/sdk": "github:modelcontextprotocol/typescript-sdk#main",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.30",
    "fs": "0.0.1-security",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.4.5"
  }
}