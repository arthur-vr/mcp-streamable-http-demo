{
  "name": "mcp-streamablehttp-demo",
  "version": "1.0.0",
  "description": "Demo of MCP Streamable HTTP protocol",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "tsx watch src/client.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "start:server": "tsx dist/server.js",
    "start:client": "tsx dist/client.js",
    "vercel:login": "vercel login",
    "dev:vercel": "pnpm build && vercel dev",
    "deploy:vercel": "vercel --prod",
    "postinstall": "tsx bin/fix-package-error.ts",
    "cleanup": "rimraf dist package-lock.json node_modules"
  },
  "keywords": [
    "mcp",
    "streamable-http",
    "typescript"
  ],
  "author": "SmileyCat",
  "dependencies": {
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.30",
    "fs": "0.0.1-security",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.4.5",
     "vercel": "^41.6.0"
  }
}